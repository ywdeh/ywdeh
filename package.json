{
    "name": "hedwy-website",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "scripts": {
        "dev": "vite dev",
        "build": "wrangler types && vite build",
        "preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
        "prepare": "svelte-kit sync",
        "gen": "wrangler types",
        "images": "node scripts/image_data.mjs",
        "check": "svelte-kit sync && svelte-check --fail-on-warnings",
        "test": "node --test tests/unit/*.test.js",
        "test:browser": "playwright test",
        "validate": "npm run check && npm test && npm run build",
        "format": "prettier --write src scripts tests *.js *.json *.jsonc *.md",
        "format:check": "prettier --check src scripts tests *.js *.json *.jsonc *.md"
    },
    "devDependencies": {
        "@playwright/test": "^1.65.1",
        "@sveltejs/adapter-cloudflare": "^7.2.8",
        "@sveltejs/kit": "^2.63.0",
        "@sveltejs/vite-plugin-svelte": "^7.1.2",
        "@tailwindcss/vite": "^4.3.0",
        "@types/node": "^26.1.2",
        "prettier": "^3.10.1",
        "prettier-plugin-svelte": "^4.1.1",
        "sharp": "^0.35.5",
        "svelte": "^5.56.1",
        "svelte-check": "^4.7.8",
        "tailwindcss": "^4.3.0",
        "vite": "^8.0.16",
        "wrangler": "^4.97.0"
    },
    "allowScripts": {
        "esbuild@0.28.2": true,
        "workerd@1.20261113.1": true
    },
    "dependencies": {
        "gsap": "^3.15.1"
    }
}
