		"check": "wrangler types --check"
	},
	"devDependencies": {
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^26.1.2",
		"svelte": "^5.56.1",
		"tailwindcss": "^4.3.0",
		"vite": "^8.0.16",
		"wrangler": "^4.97.0"
	},
	"allowScripts": {
		"esbuild@0.28.1": true,
		"workerd@1.20260801.1": true
	}
}
